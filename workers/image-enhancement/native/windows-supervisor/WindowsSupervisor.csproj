<Project>
  <PropertyGroup Condition="'$(ZebNativeTestBuild)' == 'true'">
    <BaseIntermediateOutputPath>obj-test/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin-test/</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Release artifacts must not embed the developer's absolute PDB path. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**;bin-test/**;obj-test/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ZebNativeTestBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);ZEB_NATIVE_TESTS</DefineConstants>
  </PropertyGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
